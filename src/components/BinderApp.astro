<main class="app-shell">
  <header class="topbar">
    <a class="wordmark" href="/" aria-label="Wayfinder home"><span class="wordmark-mark"><i></i><i></i><i></i><i></i></span><span>wayfinder</span></a>
    <span class="data-status"><span class="status-dot"></span> static collection</span>
  </header>

  <section class="hero" aria-labelledby="page-title">
    <div><p class="eyebrow">your collection / shelf 01</p><h1 id="page-title">Find the card.<br /><em>Keep the order.</em></h1></div>
    <p class="hero-copy">A quick, tactile map of the cards you own, the decks they’re in, and the pockets waiting for what comes next.</p>
  </section>

  <nav class="primary-tabs" aria-label="Main views">
    <button class="tab is-active" data-view="collection">Collection <span data-count="collection"></span></button>
    <button class="tab" data-view="binder">Binder</button>
    <button class="tab" data-view="wanted">Wanted <span data-count="wanted"></span></button>
  </nav>

  <section class="search-panel" aria-label="Find cards">
    <label class="searchbox"><span aria-hidden="true">⌕</span><input id="search" type="search" autocomplete="off" placeholder="Search name or code…" /><kbd>/</kbd></label>
    <div class="filters" aria-label="Filters">
      <select id="color"><option value="">All colors</option><option>Red</option><option>Green</option><option>Blue</option><option>Purple</option><option>Black</option><option>Yellow</option></select>
      <select id="cost"><option value="">Any cost</option><option value="1">Cost 1</option><option value="2">Cost 2</option><option value="3">Cost 3</option><option value="4">Cost 4+</option></select>
      <select id="type"><option value="">All types</option><option>Leader</option><option>Character</option><option>Event</option><option>Stage</option></select>
      <select id="location"><option value="">Everywhere</option><option value="binder">Binder</option><option value="deck">Decks</option></select>
      <button class="reset" id="reset">Reset</button>
    </div>
  </section>

  <div class="view-meta"><p id="view-label">All owned cards · player-first order</p><button class="sort-toggle" id="sort-toggle" hidden>Sorted view <span>↗</span></button></div>
  <section id="collection-view" class="view" aria-live="polite"><div class="card-grid" id="collection-grid"></div></section>
  <section id="binder-view" class="view" hidden aria-live="polite"><div class="binder-layout"><div class="binder-frame"><div class="sheet-heading"><div><p class="eyebrow">physical binder</p><h2 id="sheet-title">Sheet 1 · Front</h2></div><div class="side-switch"><button class="is-active" data-side="front">Front</button><button data-side="back">Back</button></div></div><div class="pocket-grid" id="pocket-grid"></div><div class="sheet-controls"><button id="prev-sheet">← Previous</button><span id="sheet-pager">Sheet 1 of 12</span><button id="next-sheet">Next →</button></div><p class="binder-note"><strong>Reserved pockets are intentional.</strong> They leave room for the next card in this group. Overflow sheets are removable, so existing cards never move.</p></div><aside class="binder-aside"><div class="aside-card"><p class="eyebrow">section map</p><div class="section-row"><span>Leaders</span><b>01</b></div><div class="section-row accent"><span>Red</span><b>04</b></div><div class="section-row"><span>Green</span><b>02</b></div><div class="section-row"><span>Blue · Purple</span><b>05</b></div></div><div class="aside-card overflow-card"><p class="eyebrow">overflow, without the shuffle</p><h3>Room for a new sheet</h3><p>New cards join the end of their color section. Your existing locations stay exactly where they are.</p><button id="overflow-button">Preview overflow</button></div></aside></div></section>
  <section id="wanted-view" class="view" hidden aria-live="polite"><div class="wanted-head"><div><p class="eyebrow">next on the shelf</p><h2>Wanted cards</h2></div><span id="wanted-total" class="total-pill"></span></div><div id="wanted-list"></div></section>
  <section id="detail-view" class="detail-view" hidden aria-live="polite"><button id="detail-back" class="back-button">← Back to collection</button><div id="detail-content"></div></section>

  <section class="location-panel"><div class="panel-heading"><div><p class="eyebrow">search answers “where?”</p><h2>Card locations</h2></div><span id="result-count"></span></div><div id="results"></div></section>
  <footer class="site-footer"><p><strong>Wayfinder</strong> is an unofficial, non-affiliated personal collection companion.</p><p>Card names, metadata, and artwork are © their respective rights holders. Data is derived from the <a href="https://github.com/featherbear/vegapull" rel="noreferrer">Vega / vegapull</a> catalog and shipped locally — no live API or Bandai logo is used.</p></footer>
</main>

<script>
  type Card = { code: string; name: string; color: string; cost: number; type: string; owned: number; binder: number; deckQty: number; deck?: string; slot?: number; sheet?: number; side?: 'front'|'back'; image?: string };
  type Want = { code: string; amount: number; target: string };
  type Payload = { cards: Card[]; wanted: Want[] };
  const demo: Payload = { cards: [
    { code:'OP01-001', name:'Roronoa Zoro', color:'Red', cost:3, type:'Leader', owned:1, binder:1, deckQty:0, slot:1, sheet:1, side:'front' },
    { code:'OP01-016', name:'Nami', color:'Red', cost:1, type:'Character', owned:4, binder:2, deckQty:2, deck:'Sabo deck', slot:2, sheet:1, side:'front' },
    { code:'OP01-025', name:'Guard Point', color:'Red', cost:1, type:'Event', owned:1, binder:1, deckQty:0, slot:3, sheet:1, side:'front' },
    { code:'OP02-004', name:'Sabo', color:'Red', cost:4, type:'Character', owned:3, binder:1, deckQty:2, deck:'Sabo deck', slot:4, sheet:1, side:'front' },
    { code:'OP01-060', name:'Donquixote Doflamingo', color:'Blue', cost:5, type:'Character', owned:1, binder:1, deckQty:0, slot:5, sheet:2, side:'front' },
    { code:'OP03-099', name:'Charlotte Pudding', color:'Purple', cost:4, type:'Character', owned:2, binder:2, deckQty:0, slot:6, sheet:2, side:'front' },
    { code:'OP04-083', name:'Rebecca', color:'Black', cost:4, type:'Leader', owned:1, binder:1, deckQty:0, slot:7, sheet:2, side:'front' }
  ], wanted: [{code:'OP05-091', amount:2, target:'binder'}, {code:'OP04-083', amount:1, target:'Luffy deck'}, {code:'OP06-086', amount:1, target:'Sabo deck'}] };
  const state = { data: demo, view: 'collection', sheet: 1, side: 'front' as 'front'|'back', selected: null as Card|null, wantedTarget: '' };
  const $ = (id: string) => document.getElementById(id)!;
  const qs = (selector: string) => document.querySelector(selector) as HTMLElement;
  const esc = (value: string) => value.replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]!));
  const order = { Leader: 0, Character: 1, Event: 2, Stage: 3 } as Record<string, number>;
  const sorted = (cards: Card[]) => cards.slice().sort((a,b) => (order[a.type]??9)-(order[b.type]??9) || a.color.localeCompare(b.color) || a.cost-b.cost || (order[a.type]??9)-(order[b.type]??9) || a.code.localeCompare(b.code));
  function filtered() { const query = ($('search') as HTMLInputElement).value.toLowerCase().trim(); const color=($('color') as HTMLSelectElement).value, cost=($('cost') as HTMLSelectElement).value, type=($('type') as HTMLSelectElement).value, location=($('location') as HTMLSelectElement).value; return sorted(state.data.cards.filter(c => (!query || `${c.name} ${c.code}`.toLowerCase().includes(query)) && (!color||c.color===color) && (!type||c.type===type) && (!cost||(cost==='4'?c.cost>=4:String(c.cost)===cost)) && (!location||(location==='binder'?c.binder>0:c.deckQty>0))); }
  function cardArt(card: Card, large=false) { return `<div class="card-art color-${card.color.toLowerCase()} ${large?'is-large':''}"><span>${esc(card.code)}</span><strong>${esc(card.name)}</strong><small>${esc(card.type)} · cost ${card.cost}</small><b>×${card.owned}</b></div>`; }
  function cardTile(card: Card) { return `<button class="collection-card" data-code="${esc(card.code)}" aria-label="Open ${esc(card.name)} details">${cardArt(card)}<span class="tile-name">${esc(card.name)}</span><span class="tile-code">${esc(card.code)} · ×${card.owned}</span><span class="tile-location">${card.binder?`Binder · sheet ${card.sheet} · slot ${card.slot}`:''}${card.deckQty?` · ${esc(card.deck||'Deck')} ×${card.deckQty}`:''}</span></button>`; }
  function renderCollection() { const cards=filtered(); $('collection-grid').innerHTML=cards.map(cardTile).join('') || `<div class="empty-state"><strong>No cards found</strong><span>Try a different name, code, or filter combination.</span></div>`; $('view-label').textContent=`${cards.length} owned card${cards.length===1?'':'s'} · player-first order`; qs('[data-count="collection"]').textContent=String(state.data.cards.length); }
  function renderBinder() { const visible=state.data.cards.filter(c=>c.sheet===state.sheet&&c.side===state.side); $('sheet-title').textContent=`Sheet ${state.sheet} · ${state.side[0].toUpperCase()+state.side.slice(1)}`; $('sheet-pager').textContent=`Sheet ${state.sheet} of 12`; $('pocket-grid').innerHTML=Array.from({length:9},(_,i)=>{const c=visible.find(card=>card.slot===i+1); return `<div class="pocket ${c?'filled':'reserved'}" data-slot="${i+1}">${c?cardArt(c):'<span>reserved</span>'}</div>`}).join(''); }
  function renderWanted() { const grouped=state.data.wanted.filter(w=>!state.wantedTarget||w.target===state.wantedTarget).reduce((map,w)=>{ (map[w.target]??=[]).push(w); return map; }, {} as Record<string,Want[]>); $('wanted-total').textContent=`${state.data.wanted.reduce((n,w)=>n+w.amount,0)} copies`; $('wanted-list').innerHTML=`<div class="wanted-filters"><button class="${!state.wantedTarget?'is-active':''}" data-target="">All targets</button>${[...new Set(state.data.wanted.map(w=>w.target))].map(t=>`<button class="${state.wantedTarget===t?'is-active':''}" data-target="${esc(t)}">${esc(t)}</button>`).join('')}</div>`+Object.entries(grouped).map(([target,items])=>`<div class="want-group"><h3>${esc(target)} <span>${items.length}</span></h3>${items.map(w=>{const c=state.data.cards.find(card=>card.code===w.code); return `<button class="want-row" data-code="${esc(w.code)}"><span>${c?esc(c.name):'Catalog card'}<small>${esc(w.code)}</small></span><b>×${w.amount}</b></button>`}).join('')}</div>`).join('') || `<div class="empty-state"><strong>Nothing wanted for this target</strong></div>`; qs('[data-count="wanted"]').textContent=String(state.data.wanted.length); }
  function renderResults() { const cards=filtered(); $('result-count').textContent=cards.length?`${cards.length} match${cards.length===1?'':'es'}`:''; $('results').innerHTML=cards.map(c=>`<button class="result-row" data-code="${esc(c.code)}"><span class="result-mark color-${c.color.toLowerCase()}"></span><span class="result-copy"><strong>${esc(c.name)}</strong><small>${esc(c.code)} · ${esc(c.color)} · ${esc(c.type)} · cost ${c.cost}</small></span><span class="locations">${c.binder?`<i>Binder · S${c.sheet} · ${c.side==='front'?'F':'B'} · ${c.slot} · ×${c.binder}</i>`:''}${c.deckQty?`<i>Deck · ${esc(c.deck||'Deck')} · ×${c.deckQty}</i>`:''}</span></button>`).join('') || `<div class="empty-state compact"><strong>No matching locations</strong><span>Search is limited to your shipped collection.</span></div>`; }
  function showView(view: string) { state.view=view; ['collection','binder','wanted'].forEach(name=>$(name+'-view').hidden=name!==view); document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('is-active', (t as HTMLElement).dataset.view===view)); $('detail-view').hidden=true; $('location-panel').hidden=view==='wanted'; render(); }
  function renderDetail(card: Card) { state.selected=card; $('collection-view').hidden=true; $('binder-view').hidden=true; $('wanted-view').hidden=true; $('location-panel').hidden=true; $('detail-view').hidden=false; $('detail-content').innerHTML=`<div class="detail-layout"><div>${cardArt(card,true)}</div><div class="detail-copy"><p class="eyebrow">card detail</p><h2>${esc(card.name)}</h2><p class="detail-code">${esc(card.code)}</p><div class="detail-tags"><span>${esc(card.color)}</span><span>${esc(card.type)}</span><span>Cost ${card.cost}</span></div><div class="quantity-grid"><div><b>×${card.owned}</b><span>owned</span></div><div><b>×${card.binder}</b><span>in binder</span></div><div><b>×${card.deckQty}</b><span>in decks</span></div></div><div class="detail-locations"><h3>Physical locations</h3><p><b>Binder</b> · Sheet ${card.sheet} ${card.side} · Slot ${card.slot} <strong>×${card.binder}</strong></p>${card.deckQty?`<p><b>Deck</b> · ${esc(card.deck||'Deck')} <strong>×${card.deckQty}</strong></p>`:''}</div>${card.binder?`<button class="show-binder" id="show-binder">Show in binder · S${card.sheet} · ${card.side==='front'?'Front':'Back'} · Slot ${card.slot} <span>→</span></button>`:''}</div></div>`; }
  function render() { renderCollection(); renderBinder(); renderWanted(); renderResults(); }
  $('search').addEventListener('input', render); ['color','cost','type','location'].forEach(id=>$(id).addEventListener('change',render)); $('reset').addEventListener('click',()=>{['search','color','cost','type','location'].forEach(id=>($(id) as HTMLInputElement).value='');render();}); document.querySelectorAll('.tab').forEach(tab=>tab.addEventListener('click',()=>showView((tab as HTMLElement).dataset.view!))); document.querySelectorAll('[data-side]').forEach(btn=>btn.addEventListener('click',()=>{state.side=(btn as HTMLElement).dataset.side as 'front'|'back';document.querySelectorAll('[data-side]').forEach(b=>b.classList.toggle('is-active',b===btn));renderBinder();})); $('prev-sheet').addEventListener('click',()=>{state.sheet=Math.max(1,state.sheet-1);renderBinder();}); $('next-sheet').addEventListener('click',()=>{state.sheet=Math.min(12,state.sheet+1);renderBinder();}); $('overflow-button').addEventListener('click',e=>{(e.currentTarget as HTMLButtonElement).textContent='Preview added · no cards moved';});
  document.addEventListener('click',e=>{ const target=e.target as HTMLElement; const card=state.data.cards.find(c=>c.code===target.closest('[data-code]')?.getAttribute('data-code')); if(card && !target.closest('[data-slot]')) { if(target.closest('#show-binder')) return; renderDetail(card); window.scrollTo({top:0,behavior:'smooth'}); } const filter=target.closest('[data-target]') as HTMLElement; if(filter){state.wantedTarget=filter.dataset.target||'';renderWanted();} }); $('detail-back').addEventListener('click',()=>showView('collection')); $('detail-content').addEventListener('click',e=>{if((e.target as HTMLElement).closest('#show-binder')&&state.selected){state.sheet=state.selected.sheet||1;state.side=state.selected.side||'front';showView('binder');setTimeout(()=>{const pocket=document.querySelector(`[data-slot="${state.selected!.slot}"]`);pocket?.classList.add('highlight');pocket?.scrollIntoView({behavior:'smooth',block:'center'});},100);}});
  fetch(`${import.meta.env.BASE_URL}data/binder.json`).then(response=>response.ok?response.json():Promise.reject()).then((data: Payload)=>{if(data?.cards?.length)state.data=data;render();}).catch(()=>render()); render();
</script>
