<main class="app-shell">
  <header class="topbar">
    <a class="wordmark" href={import.meta.env.BASE_URL} aria-label="Wayfinder home"><span class="wordmark-mark"><i></i><i></i><i></i><i></i></span><span>wayfinder</span></a>
    <span class="data-status"><span class="status-dot"></span><span id="data-status-label">static collection</span></span>
  </header>

  <section class="hero" aria-labelledby="page-title">
    <div><p class="eyebrow">your collection / shelf 01</p><h1 id="page-title">Find the card.<br /><em>Keep the order.</em></h1></div>
    <p class="hero-copy">A quick, tactile map of the cards you own, the decks they’re in, and the pockets waiting for what comes next.</p>
  </section>

  <nav class="primary-tabs" aria-label="Main views">
    <button class="tab is-active" data-view="collection">Collection <span data-count="collection"></span></button>
    <button class="tab" data-view="binder">Binder</button>
    <button class="tab" data-view="wanted">Wanted <span data-count="wanted"></span></button>
  </nav>

  <section class="search-panel" aria-label="Find cards">
    <label class="searchbox"><span aria-hidden="true">⌕</span><input id="search" type="search" autocomplete="off" placeholder="Search name or code…" /><kbd>/</kbd></label>
    <div class="filters" aria-label="Filters">
      <select id="color" aria-label="Filter by color"><option value="">All colors</option><option>Red</option><option>Green</option><option>Blue</option><option>Purple</option><option>Black</option><option>Yellow</option></select>
      <select id="cost" aria-label="Filter by cost"><option value="">Any cost</option><option value="1">Cost 1</option><option value="2">Cost 2</option><option value="3">Cost 3</option><option value="4">Cost 4+</option></select>
      <select id="type" aria-label="Filter by type"><option value="">All types</option><option>Leader</option><option>Character</option><option>Event</option><option>Stage</option></select>
      <select id="location" aria-label="Filter by location"><option value="">Everywhere</option><option value="binder">Binder</option><option value="deck">Decks</option></select>
      <select id="deck" aria-label="Filter by deck"><option value="">All decks</option></select>
      <button class="reset" id="reset">Reset</button>
    </div>
  </section>

  <div class="view-meta"><p id="view-label">All owned cards · player-first order</p><button class="sort-toggle" id="sort-toggle" hidden>Sorted view <span>↗</span></button></div>
  <section id="collection-view" class="view" aria-live="polite"><div class="card-grid" id="collection-grid"></div></section>
  <section id="binder-view" class="view" hidden aria-live="polite"><div class="binder-layout"><div class="binder-frame"><div class="sheet-heading"><div><p class="eyebrow">physical binder</p><h2 id="sheet-title"></h2></div><div class="side-switch"><button class="is-active" data-side="front">Front</button><button data-side="back">Back</button></div></div><div class="pocket-grid" id="pocket-grid"></div><div class="sheet-controls"><button id="prev-sheet">← Previous</button><span id="sheet-pager"></span><button id="next-sheet">Next →</button></div><p class="binder-note" id="binder-note"></p></div><aside class="binder-aside"><div class="aside-card"><p class="eyebrow">section map</p><div id="section-map"></div></div><div class="aside-card overflow-card"><p class="eyebrow">overflow, without the shuffle</p><h3 id="overflow-title"></h3><p id="overflow-copy"></p><button id="overflow-button">View overflow status</button></div></aside></div></section>
  <section id="wanted-view" class="view" hidden aria-live="polite"><div class="wanted-head"><div><p class="eyebrow">next on the shelf</p><h2>Wanted cards</h2></div><span id="wanted-total" class="total-pill"></span></div><div id="wanted-list"></div></section>
  <section id="detail-view" class="detail-view" hidden aria-live="polite"><button id="detail-back" class="back-button">← Back to collection</button><div id="detail-content"></div></section>

  <section id="location-panel" class="location-panel"><div class="panel-heading"><div><p class="eyebrow">search answers “where?”</p><h2>Card locations</h2></div><span id="result-count"></span></div><div id="results"></div></section>
  <section id="data-state" class="data-state" hidden aria-live="polite"><p class="eyebrow">collection unavailable</p><h2>We couldn’t load the binder data.</h2><p id="data-state-copy">Try refreshing when the published data file is available.</p></section>
  <footer class="site-footer"><p><strong>Wayfinder</strong> · <span id="attribution-disclaimer">unofficial, non-affiliated personal collection companion.</span></p><p id="attribution-copy">Card names, metadata, and artwork are © their respective rights holders. Data is shipped locally — no live API or Bandai logo is used.</p></footer>
</main>

<script>
  import { resolveCardImagePath } from '../lib/data/image-url';
  import { deckNames, hasPositiveDeckAllocation } from '../lib/collection/filter';

  type Catalog = { code: string; name: string|null; color: string|null; cost: number|null; type: string|null; image?: string; imagePath?: string };
  type CardEntry = { code: string; name: string|null; owned: number; binderQuantity: number; deckAllocations: { deck: string; quantity: number }[]; binderLocation: { sheet: number; side: 'Front'|'Back'; slot: number }|null; image?: string };
  type SlotStatus = 'reserved'|'vacant'|'empty'|'card';
  type DiscriminatedSlot = { status: 'card'; code: string; quantity: number } | { status: 'reserved'|'vacant'|'empty' };
  type Sheet = { sheet: number; side: 'Front'|'Back'; slots: DiscriminatedSlot[] };
  type LayoutPocket = { sheetId: string; section: string; pocket: number; status: SlotStatus; code?: string; quantity?: number; tag?: string };
  type LayoutSheet = { sheetId: string; sheet: number; side: 'Front'|'Back'; pockets: LayoutPocket[] };
  type BinderLayout = { version: number; slotsPerSide: number; sheets: LayoutSheet[] };
  type BinderData = { meta: { catalogSource: string; totalSheets: number; dataProvenance?: string }; catalog: Catalog[]; cards: CardEntry[]; sheets: Sheet[]; binder: { totalSheets: number; reservedSlots: number; overflowSheets: number }; wanted: { code: string; amount: number; target: string }[]; sources: Record<string, unknown>; attribution: { copyright?: string; disclaimer?: string; dataSource?: string; dataSourceUrl?: string; toolUsed?: string }; layout?: BinderLayout; binderLayout?: BinderLayout };
  type Card = { code: string; name: string; color: string; cost: number; type: string; owned: number; binder: number; deckQty: number; decks: { deck: string; quantity: number }[]; slot?: number; sheet?: number; side?: 'front'|'back'; sheetId?: string; section?: string; image?: string };
  const state = { data: null as BinderData|null, layout: null as BinderLayout|null, view: 'collection', sheet: 1, side: 'front' as 'front'|'back', selected: null as Card|null, wantedTarget: '', loading: true };
  const $ = (id: string) => document.getElementById(id)!;
  const qs = (selector: string) => document.querySelector(selector) as HTMLElement;
  const esc = (value: string) => value.replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]!));
  const order = { Leader: 0, Character: 1, Event: 2, Stage: 3 } as Record<string, number>;
  const colors = { Red: 0, Green: 1, Blue: 2, Purple: 3, Black: 4, Yellow: 5 } as Record<string, number>;
  const catalogFor = (code: string) => state.data?.catalog.find(entry => entry.code === code);
  const layoutForCode = (code: string) => state.layout?.sheets.flatMap(sheet=>sheet.pockets.map(pocket=>({...pocket,sheet:sheet.sheet,side:sheet.side}))).find(pocket=>pocket.status==='card'&&pocket.code===code);
  const cardFor = (entry: CardEntry): Card => { const catalog=catalogFor(entry.code); const location=entry.binderLocation; const ledger=layoutForCode(entry.code); const decks=entry.deckAllocations||[]; return { code:entry.code, name:entry.name||catalog?.name||'Unknown card', color:catalog?.color||'Unknown', cost:catalog?.cost??0, type:catalog?.type||'Card', owned:entry.owned, binder:entry.binderQuantity, deckQty:decks.reduce((sum,deck)=>sum+deck.quantity,0), decks, slot:ledger?.pocket||location?.slot, sheet:ledger?.sheet||location?.sheet, side:(ledger?.side||location?.side)==='Front'?'front':'back', sheetId:ledger?.sheetId, section:ledger?.section, image:catalog?.image||catalog?.imagePath }; };
  const cards = () => state.data?.cards.map(cardFor) || [];
  const physicalSheets = () => state.layout?.sheets || (state.data?.sheets||[]).map(sheet=>({ sheetId:`sheet-${sheet.sheet}-${sheet.side}`, sheet:sheet.sheet, side:sheet.side, pockets:sheet.slots.map((slot,index)=>slot.status==='card'?{sheetId:`sheet-${sheet.sheet}-${sheet.side}`,section:'',pocket:index+1,status:'card' as SlotStatus,code:slot.code,quantity:slot.quantity}:{sheetId:`sheet-${sheet.sheet}-${sheet.side}`,section:'',pocket:index+1,status:slot.status}) }));
  const sheetNumbers = () => [...new Set(physicalSheets().map(sheet=>sheet.sheet))].sort((a,b)=>a-b);
  const wantedFor = (code: string) => state.data?.wanted.filter(entry=>entry.code===code) || [];
  const wantedLabel = (code: string) => { const entries=wantedFor(code); return entries.length?`<span class="wanted-badge">Wanted · ${entries.map(entry=>`${esc(entry.target)} ×${entry.amount}`).join(' · ')}</span>`:''; };
  const deckLabels = (card: Card) => card.decks.map(deck=>`${esc(deck.deck)} ×${deck.quantity}`).join(' · ');
  const decodeLayout = (value: unknown): BinderLayout|null => { if(!value||typeof value!=='object'||!Array.isArray((value as BinderLayout).sheets))return null; const sheets=(value as BinderLayout).sheets; if(!sheets.every(sheet=>Array.isArray(sheet.pockets)&&sheet.pockets.every(pocket=>['card','reserved','vacant','empty'].includes(pocket.status))))return null; return value as BinderLayout; };
  const sorted = (cards: Card[]) => cards.slice().sort((a,b) => (a.type==='Leader'?0:1)-(b.type==='Leader'?0:1) || (colors[a.color]??9)-(colors[b.color]??9) || a.cost-b.cost || (order[a.type]??9)-(order[b.type]??9) || a.code.localeCompare(b.code));
  function renderDeckOptions() { const select=$('deck') as HTMLSelectElement; const selected=select.value; const names=deckNames(cards()); select.innerHTML='<option value="">All decks</option>'+names.map(deck=>`<option value="${esc(deck)}">${esc(deck)}</option>`).join(''); if(names.includes(selected))select.value=selected; }
  function filtered() { const query = ($('search') as HTMLInputElement).value.toLowerCase().trim(); const color=($('color') as HTMLSelectElement).value, cost=($('cost') as HTMLSelectElement).value, type=($('type') as HTMLSelectElement).value, location=($('location') as HTMLSelectElement).value, deck=($('deck') as HTMLSelectElement).value; return sorted(cards().filter(c => (!query || `${c.name} ${c.code}`.toLowerCase().includes(query)) && (!color||c.color===color) && (!type||c.type===type) && (!cost||(cost==='4'?c.cost>=4:String(c.cost)===cost)) && (!location||(location==='binder'?c.binder>0:c.deckQty>0)) && (!deck||hasPositiveDeckAllocation(c,deck)))); }
  function cardArt(card: Card, large=false) { const imagePath=resolveCardImagePath(import.meta.env.BASE_URL, card.image); const art=imagePath ? `<img src="${esc(imagePath)}" alt="" loading="lazy" />` : `<span class="art-unavailable">Artwork unavailable</span>`; return `<div class="card-art ${imagePath?'has-art':'art-missing'} ${large?'is-large':''}">${art}<div class="art-label"><span>${esc(card.code)}</span><strong>${esc(card.name)}</strong><small>${esc(card.type)} · cost ${card.cost}</small></div><b>×${card.owned}</b></div>`; }
  function cardTile(card: Card) { return `<button class="collection-card" data-code="${esc(card.code)}" aria-label="Open ${esc(card.name)} details">${cardArt(card)}<span class="tile-name">${esc(card.name)}</span>${wantedLabel(card.code)}<span class="tile-code">${esc(card.code)} · ×${card.owned}</span><span class="tile-location">${card.binder?`Binder · sheet ${card.sheet} · slot ${card.slot}`:''}${card.deckQty?` · Decks · ${deckLabels(card)}`:''}</span></button>`; }
  function renderCollection() { const visible=filtered(); $('collection-grid').innerHTML=visible.map(cardTile).join('') || `<div class="empty-state"><strong>No cards found</strong><span>Try a different name, code, or filter combination.</span></div>`; $('view-label').textContent=`${visible.length} owned card${visible.length===1?'':'s'} · player-first order`; qs('[data-count="collection"]').textContent=String(cards().length); }
  function renderBinder() { const sheet=physicalSheets().find(item=>item.sheet===state.sheet&&item.side===(state.side==='front'?'Front':'Back')); const total=sheetNumbers().length; const sections=[...new Set((sheet?.pockets||[]).map(pocket=>pocket.section).filter(Boolean))]; const isOverflow=Boolean(sheet?.sheetId?.toLowerCase().includes('overflow')); const sectionLabel=sections.length?` · ${sections.join(' · ')}`:''; const overflowLabel=isOverflow?' · Removable overflow sheet':''; $('sheet-title').textContent=`Sheet ${state.sheet} · ${state.side[0].toUpperCase()+state.side.slice(1)}${sectionLabel}${overflowLabel}`; $('sheet-pager').textContent=`Sheet ${state.sheet} of ${total}`; $('prev-sheet').toggleAttribute('disabled', state.sheet===sheetNumbers()[0]); $('next-sheet').toggleAttribute('disabled', state.sheet===sheetNumbers()[total-1]); const pockets=sheet?.pockets||[]; $('pocket-grid').setAttribute('aria-label', isOverflow ? `Removable overflow sheet ${state.sheet} ${state.side}` : `Binder sheet ${state.sheet} ${state.side}`); $('pocket-grid').innerHTML=pockets.map(pocket=>{const c=pocket.code?cards().find(card=>card.code===pocket.code):undefined; const quantity=pocket.quantity ?? (c ? c.owned : 0); const content=pocket.status==='card'&&c?cardArt({...c,owned:quantity}):`<span>${esc(pocket.status)}</span>`; return `<div class="pocket pocket-${pocket.status}" data-slot="${pocket.pocket}" data-sheet-id="${esc(pocket.sheetId)}">${content}</div>`}).join(''); renderBinderMeta(); }
  function renderBinderMeta() { const data=state.data!; const sections=physicalSheets().flatMap(sheet=>sheet.pockets).reduce((counts,pocket)=>{if(pocket.section)counts[pocket.section]=(counts[pocket.section]||0)+1;return counts;},{} as Record<string,number>); const fallback=cards().reduce((counts,card)=>{if(card.binder)counts[card.color]=(counts[card.color]||0)+1;return counts;},{} as Record<string,number>); const map=Object.keys(sections).length?sections:fallback; $('section-map').innerHTML=Object.entries(map).map(([section,count])=>`<div class="section-row ${section.includes('Red')?'accent':''}"><span>${esc(section)}</span><b>${count.toString().padStart(2,'0')}</b></div>`).join('')||'<p class="aside-muted">No placed cards yet.</p>'; const reserved=data.binder.reservedSlots||0; const vacant=physicalSheets().flatMap(sheet=>sheet.pockets).filter(pocket=>pocket.status==='vacant').length; $('binder-note').innerHTML=`<strong>${reserved} reserved · ${vacant} vacant.</strong> Empty pockets are labelled from the physical ledger, so the published layout remains stable.`; const overflow=data.binder.overflowSheets||0; $('overflow-title').textContent=overflow?`${overflow} overflow sheet${overflow===1?'':'s'} published`:'No overflow sheets published'; $('overflow-copy').textContent=overflow?'New cards are kept in removable overflow after their section. Existing locations do not move.':'The current layout fits its sections. New overflow status will appear here when the generated binder adds a removable sheet.'; }
  function renderAttribution() { const data=state.data!; $('data-status-label').textContent=`${data.meta.catalogSource||'Vega'} catalog`; $('attribution-disclaimer').textContent=data.attribution.disclaimer||'unofficial, non-affiliated personal collection companion.'; $('attribution-copy').textContent=`${data.attribution.copyright||'Card names, metadata, and artwork belong to their respective rights holders.'} Data source: ${data.attribution.dataSource||'Vega'} · Tool: ${data.attribution.toolUsed||'vegapull'}. No live API or Bandai logo is used.`; }
  function renderWanted() { const data=state.data!; const grouped=data.wanted.filter(w=>!state.wantedTarget||w.target===state.wantedTarget).reduce((map,w)=>{ (map[w.target]??=[]).push(w); return map; }, {} as Record<string,{code:string;amount:number;target:string}[]>); $('wanted-total').textContent=`${data.wanted.reduce((n,w)=>n+w.amount,0)} copies`; $('wanted-list').innerHTML=`<div class="wanted-filters"><button class="${!state.wantedTarget?'is-active':''}" data-target="">All targets</button>${[...new Set(data.wanted.map(w=>w.target))].map(t=>`<button class="${state.wantedTarget===t?'is-active':''}" data-target="${esc(t)}">${esc(t)}</button>`).join('')}</div>`+Object.entries(grouped).map(([target,items])=>`<div class="want-group"><h3>${esc(target)} <span>${items.length}</span></h3>${items.map(w=>{const c=cards().find(card=>card.code===w.code); return `<button class="want-row" data-code="${esc(w.code)}"><span>${c?esc(c.name):'Catalog card'}<small>${esc(w.code)}</small></span><b>×${w.amount}</b></button>`}).join('')}</div>`).join('') || `<div class="empty-state"><strong>Nothing wanted for this target</strong></div>`; qs('[data-count="wanted"]').textContent=String(data.wanted.length); }
  function renderResults() { const cards=filtered(); $('result-count').textContent=cards.length?`${cards.length} match${cards.length===1?'':'es'}`:''; $('results').innerHTML=cards.map(c=>`<button class="result-row" data-code="${esc(c.code)}"><span class="result-mark color-${c.color.toLowerCase()} "></span><span class="result-copy"><strong>${esc(c.name)}</strong>${wantedLabel(c.code)}<small>${esc(c.code)} · ${esc(c.color)} · ${esc(c.type)} · cost ${c.cost}</small></span><span class="locations">${c.binder?`<i>Binder · S${c.sheet} · ${c.side==='front'?'F':'B'} · ${c.slot} · ×${c.binder}</i>`:''}${c.deckQty?`<i>Decks · ${deckLabels(c)}</i>`:''}</span></button>`).join('') || `<div class="empty-state compact"><strong>No matching locations</strong><span>Search is limited to your shipped collection.</span></div>`; }
  function showView(view: string) { state.view=view; ['collection','binder','wanted'].forEach(name=>$(name+'-view').hidden=name!==view); document.querySelectorAll('.tab').forEach(t=>t.classList.toggle('is-active', (t as HTMLElement).dataset.view===view)); $('detail-view').hidden=true; $('location-panel').hidden=view==='wanted'; render(); }
  function renderDetail(card: Card) { state.selected=card; $('collection-view').hidden=true; $('binder-view').hidden=true; $('wanted-view').hidden=true; $('location-panel').hidden=true; $('detail-view').hidden=false; $('detail-content').innerHTML=`<div class="detail-layout"><div>${cardArt(card,true)}</div><div class="detail-copy"><p class="eyebrow">card detail</p><h2>${esc(card.name)}</h2><p class="detail-code">${esc(card.code)}</p>${wantedLabel(card.code)}<div class="detail-tags"><span>${esc(card.color)}</span><span>${esc(card.type)}</span><span>Cost ${card.cost}</span></div><div class="quantity-grid"><div><b>×${card.owned}</b><span>owned</span></div><div><b>×${card.binder}</b><span>in binder</span></div><div><b>×${card.deckQty}</b><span>in decks</span></div></div><div class="detail-locations"><h3>Physical locations</h3>${card.binder?`<p><b>Binder</b> · Sheet ${card.sheet} ${card.side} · Slot ${card.slot} <strong>×${card.binder}</strong></p>`:'<p><b>Binder</b> · No copies stored in binder</p>'}${card.decks.map(deck=>`<p><b>Deck</b> · ${esc(deck.deck)} <strong>×${deck.quantity}</strong></p>`).join('')}</div>${card.binder?`<button class="show-binder" id="show-binder">Show in binder · S${card.sheet} · ${card.side==='front'?'Front':'Back'} · Slot ${card.slot} <span>→</span></button>`:''}</div></div>`; }
  function renderUnavailable(message: string) { state.loading=false; $('data-state').hidden=false; $('data-state-copy').textContent=message; ['collection-view','binder-view','wanted-view','detail-view','location-panel','search-panel','view-meta'].forEach(id=>$(id).hidden=true); }
  function render() { if(!state.data) return; renderAttribution(); renderDeckOptions(); renderCollection(); renderBinder(); renderWanted(); renderResults(); }
  $('search').addEventListener('input', render); ['color','cost','type','location','deck'].forEach(id=>$(id).addEventListener('change',render)); $('reset').addEventListener('click',()=>{['search','color','cost','type','location','deck'].forEach(id=>($(id) as HTMLInputElement).value='');render();}); document.querySelectorAll('.tab').forEach(tab=>tab.addEventListener('click',()=>showView((tab as HTMLElement).dataset.view!))); document.querySelectorAll('[data-side]').forEach(btn=>btn.addEventListener('click',()=>{state.side=(btn as HTMLElement).dataset.side as 'front'|'back';document.querySelectorAll('[data-side]').forEach(b=>b.classList.toggle('is-active',b===btn));renderBinder();})); $('prev-sheet').addEventListener('click',()=>{const numbers=sheetNumbers(); state.sheet=numbers[Math.max(0,numbers.indexOf(state.sheet)-1)]||state.sheet;renderBinder();}); $('next-sheet').addEventListener('click',()=>{const numbers=sheetNumbers(); state.sheet=numbers[Math.min(numbers.length-1,numbers.indexOf(state.sheet)+1)]||state.sheet;renderBinder();}); $('overflow-button').addEventListener('click',e=>{(e.currentTarget as HTMLButtonElement).textContent=state.data?.binder.overflowSheets?'Status is shown above':'No overflow in generated data';});
  document.addEventListener('click',e=>{ if(!state.data)return; const target=e.target as HTMLElement; const card=cards().find(c=>c.code===target.closest('[data-code]')?.getAttribute('data-code')); if(card && !target.closest('[data-slot]')) { if(target.closest('#show-binder')) return; renderDetail(card); window.scrollTo({top:0,behavior:'smooth'}); } const filter=target.closest('[data-target]') as HTMLElement; if(filter){state.wantedTarget=filter.dataset.target||'';renderWanted();} }); $('detail-back').addEventListener('click',()=>showView('collection')); $('detail-content').addEventListener('click',e=>{if((e.target as HTMLElement).closest('#show-binder')&&state.selected){state.sheet=state.selected.sheet||1;state.side=state.selected.side||'front';showView('binder');requestAnimationFrame(()=>{const pocket=document.querySelector(`[data-slot="${state.selected!.slot}"]`);pocket?.classList.add('highlight');pocket?.scrollIntoView({behavior:'smooth',block:'center'});});}});
  const layoutRequest=fetch(`${import.meta.env.BASE_URL}/data/binder-layout.json`).then(response=>response.ok?response.json():null).then(decodeLayout).catch(()=>null);
  fetch(`${import.meta.env.BASE_URL}/data/binder.json`).then(response=>response.ok?response.json():Promise.reject(new Error('binder data request failed'))).then((data: BinderData)=>Promise.all([Promise.resolve(data),layoutRequest])).then(([data,layout])=>{if(!data?.meta||!Array.isArray(data.catalog)||!Array.isArray(data.cards)||!Array.isArray(data.sheets)||!data.binder||!Array.isArray(data.wanted)||!data.sources||!data.attribution)throw new Error('binder data contract is incomplete'); state.data=data; state.layout=decodeLayout(data.layout)||decodeLayout(data.binderLayout)||layout; state.loading=false; state.sheet=sheetNumbers()[0]||1; render();}).catch(()=>renderUnavailable('The generated BinderData file is missing or could not be read. Nothing has been substituted, so the collection will appear when the data pipeline publishes it.'));
</script>
